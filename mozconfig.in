# wine/make_package -win64 が作る mozconfig を aarch64-w64-mingw32 に置き換えたもの
export CROSS_COMPILE=1
ac_add_options --target=aarch64-w64-mingw32
mk_add_options MOZ_OBJDIR="@OBJDIR@"
mk_add_options MOZ_MAKE_FLAGS="-j@JOBS@ -s"
ac_add_options --disable-debug
ac_add_options --enable-optimize
# --with-ccache は config/external/nss で "multiple target patterns" になったので使わない

# wine/mozconfig-common と同じ
ac_add_options --enable-default-toolkit=cairo-windows
# 公式は --enable-accessibility。aarch64 では widl の生成するプロキシが通らないので当面無効
ac_add_options --disable-accessibility
ac_add_options --disable-tests
ac_add_options --disable-updater
ac_add_options --disable-necko-wifi
ac_add_options --disable-crashreporter
ac_add_options --disable-webgl
ac_add_options --disable-webrtc
ac_add_options --without-intl-api
ac_add_options --disable-sandbox
ac_add_options --disable-gamepad
ac_add_options --disable-maintenance-service
ac_add_options --disable-parental-controls
export CFLAGS="$CFLAGS -DWINE_GECKO_SRC"
export CXXFLAGS="$CXXFLAGS -DWINE_GECKO_SRC"
export HOST_LDFLAGS=" "
export HOST_CFLAGS=" "
export HOST_CXXFLAGS=" "

# aarch64 用に追加: JIT (aarch64 はもともと JS_CODEGEN_NONE) とメディアなど
ac_add_options --disable-ion
ac_add_options --disable-webspeech
ac_add_options --disable-ffmpeg
ac_add_options --disable-fmp4
ac_add_options --disable-eme
ac_add_options --disable-directshow
ac_add_options --disable-raw
ac_add_options --disable-ctypes
